# Required. Send it as: Authorization: Bearer <this value>
# MUSE_API_KEY is accepted as an alias.
AMAZON_API_KEY=replace-me

# Optional
HOST=127.0.0.1
PORT=8792
AMAZON_DEFAULT_REGION=us
AMAZON_COOKIE_DIR=~/.amazon-cart
